height="36" as="geometry"/></mxCell><mxCell id="c32" value="Databricks (if dedicated)" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/analytics/Azure_Databricks.svg;" vertex="1" parent="1"><mxGeometry x="1312.0" y="448" width="36" height="36" as="geometry"/></mxCell><mxCell id="c33" value="Private endpoint" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/networking/Private_Link.svg;" vertex="1" parent="1"><mxGeometry x="1492.0" y="448" width="36" height="36" as="geometry"/></mxCell><mxCell id="c34" value="peering / vWAN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#444;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c7" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Company C workload subscription&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;sub-company-c-data-prod&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF6EA;strokeColor=#107C10;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="540" width="720" height="125" as="geometry"/></mxCell><mxCell id="c36" value="Company C VNet" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="952.0" y="588" width="36" height="36" as="geometry"/></mxCell><mxCell id="c37" value="Company C ADLS Gen2" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1132.0" y="588" width="36" height="36" as="geometry"/></mxCell><mxCell id="c38" value="Databricks (if dedicated)" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/analytics/Azure_Databricks.svg;" vertex="1" parent="1"><mxGeometry x="1312.0" y="588" width="36" height="36" as="geometry"/></mxCell><mxCell id="c39" value="Private endpoint" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/networking/Private_Link.svg;" vertex="1" parent="1"><mxGeometry x="1492.0" y="588" width="36" height="36" as="geometry"/></mxCell><mxCell id="c40" value="peering / vWAN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#444;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c7" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;• Private Link ≠ VNet peering: private endpoints give private access to supported PaaS services.&lt;br&gt;• ADF options: managed VNet + managed private endpoints, self-hosted IR, or approved public endpoints, depending on source.&lt;br&gt;• Databricks: validate secure cluster connectivity, VNet injection and serverless connectivity against current docs.&lt;br&gt;• VPN is encrypted but usually crosses the public internet. It is not a physically private circuit. Use ExpressRoute via a provider for private dedicated connectivity.&lt;br&gt;• AWS S3 ingestion: native connectors/shortcuts, controlled HTTPS, private connectivity, or secure replication. Choose on throughput, latency, residency, security, cost." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#666;verticalAlign=top;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="1570" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Data platform end-to-e