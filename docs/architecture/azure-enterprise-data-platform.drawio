ize=9;strokeColor=#444;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="Dim_Account&lt;br&gt;&lt;font style='font-size:9px'&gt;local CoA mapped to enterprise CoA (effective-dated)&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#666;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="250" height="70" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#444;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="Dim_Cost_Center" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#666;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="230" width="250" height="70" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#444;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="Dim_Currency" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#666;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="380" width="250" height="70" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#444;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="Dim_Customer (optional)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#8A8886;verticalAlign=middle;align=center;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="480" width="120" height="60" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#444;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c2" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="Dim_Product (optional)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#8A8886;verticalAlign=middle;align=center;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="480" width="120" height="60" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#444;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="c2" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Separate facts, own grain, shared conformed dimensions&lt;/b&gt;&lt;br&gt;Fact_Monthly_Account_Balance (account / entity / currency / period, semi-additive)&lt;br&gt;Fact_Budget · Fact_Forecast · Fact_Intercompany_Transaction&lt;br&gt;FX rate reference table (date / currency pair)&lt;br&gt;Aggregate each to a common conformed grain before combining. Never join facts of different grains directly." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B8860B;verticalAlign=top;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="640" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Silver to Gold&lt;/b&gt;&lt;br&gt;Silver: canonical entities, source mappings, conformed attributes, SCD history, MDM golden IDs.&lt;br&gt;Gold: business-process facts and dimensions with agreed grain.&lt;br&gt;Power BI: star relationships, single-direction filters, governed DAX measures." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#B8890B;verticalAlign=top;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="580" width="570" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>