x="1" parent="1"><mxGeometry x="1355" y="365" width="250" height="170" as="geometry"/></mxCell><mxCell id="c54" value="VNet" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="1369.25" y="440" width="34" height="34" as="geometry"/></mxCell><mxCell id="c55" value="ADLS Gen2 B/S/G" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1431.75" y="440" width="34" height="34" as="geometry"/></mxCell><mxCell id="c56" value="Databricks (if dedicated)" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/analytics/Azure_Databricks.svg;" vertex="1" parent="1"><mxGeometry x="1494.25" y="440" width="34" height="34" as="geometry"/></mxCell><mxCell id="c57" value="Key Vault" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/security/Key_Vaults.svg;" vertex="1" parent="1"><mxGeometry x="1556.75" y="440" width="34" height="34" as="geometry"/></mxCell><mxCell id="c58" value="Sandbox&lt;br&gt;&lt;font style='font-size:9px'&gt;Experimentation. Strict budget, policy and time limits.&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B8860B;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="565" width="300" height="70" as="geometry"/></mxCell><mxCell id="c59" value="Decommissioned / Quarantine (optional)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#8A8886;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="565" width="300" height="70" as="geometry"/></mxCell><mxCell id="c60" value="Corp (internal, private connectivity) and Online (internet-facing, extra ingress/egress controls) archetypes sit under Landing Zones" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#8A8886;verticalAlign=top;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="670" y="565" width="420" height="70" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Inheritance:&lt;/b&gt; Tenant → Management group → Subscription → Resource group → Resource. Policy and RBAC inherit downward. Management groups = governance boundaries; subscriptions = billing, quota, RBAC and isolation. A subscription alone does not isolate the data plane: storage ACLs, network rules and identities still apply." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B8860B;verticalAlign=top;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="565" width="510" height="100" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;CAF:&lt;/b&gt; Strategy → Plan → &lt;b&gt;Ready (landing zone)&lt;/b&gt; → Adopt → Govern → Secure → Manage" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#0078D4;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="760" height="40" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Operating model:&lt;/b&gt; centralized guardrails · federated data ownership · explicit security boundaries · reusable platform services · cost accountability by subscription/domain" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#107C10;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="745" width="1590" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Hub-spoke network" id="p1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Connectivity: hub-spoke with cross-cloud ingestion&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="5" width="600" height="24" as="geometry"/></mxCell><mxCell id="c2" value="On-premises data centres&lt;br&gt;(ERP, trading, billing DBs)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#8A8886;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="200" height="70" as="geometry"/></mxCell><mxCell id="c3" value="AWS VPC / S3 workloads&lt;br&gt;(acquired data)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#8A8886;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="200" height="70" as="geometry"/></mxCell><mxCell id="c4" value="ExpressRoute / S2S VPN /&lt;br&gt;approved cross-cloud link" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/networking/ExpressRoute_Circuits.svg;" vertex="1" parent="1"><mxGeometry x="290" y="235" width="44" height="44" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#444;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;strokeColor=#444;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Connectivity subscription: hub VNet (or Virtual WAN hub)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E8F1FA;strokeColor=#0078D4;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="380" height="520" as="geometry"/></mxCell><mxCell id="c8" value="VPN / ER gateway" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="450" y="190" width="40" height="40" as="geometry"/></mxCell><mxCell id="c9" value="Azure Firewall Premium / NVA" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="1"><mxGeometry x="570" y="190" width="40" height="40" as="geometry"/></mxCell><mxCell id="c10" value="Private DNS / resolver" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/networking/DNS_Zones.svg;" vertex="1" parent="1"><mxGeometry x="690" y="190" width="40" height="40" as="geometry"/></mxCell><mxCell id="c11" value="Hub VNet routing" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="450" y="330" width="40" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Azure Bastion" style="image;aspect=fixed;html=1;points=[];align=center;verticalAlign=top;labelPosition=center;verticalLabelPosition=bottom;fontSize=9;image=img/lib/azure2/networking/Bastions.svg;" vertex="1" parent="1"><mxGeometry x="570" y="330" width="40" height="40" as="geometry"/></mxCell><mxCell id="c13" value="DDoS Protection" style="image;aspect=fixed;html=1;points=[];align=center;verticalA